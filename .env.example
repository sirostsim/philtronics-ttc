# -----------------------------------------------------------------------------
# Philtronics Time-to-Complete - Environment Variables
# -----------------------------------------------------------------------------
# LOCAL:   Copy to server/.env and edit.
# RAILWAY: Set these in the Railway dashboard -> Variables tab.
#          Do NOT commit a real .env to git (.env and server/.env are ignored).
#
# This file is the authoritative inventory of every variable the app reads.
# Placeholders only - never put a real secret in here.
#
# After a secret rotation (e.g. the Oct 2026 Railway incident, see
# docs/railway-incident-2026-10.md), update the value in Railway and REDEPLOY:
# containers read environment variables only at startup.
# -----------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# REQUIRED. Signs BOTH internal user sessions and portal (customer) sessions,
# plus the short-lived 2FA setup token. Rotating it logs EVERYONE out. Generate:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_64_CHARS_MINIMUM
JWT_EXPIRES_IN=8h

# REQUIRED. PostgreSQL connection string. On Railway this is provided by the
# Postgres service; rotate it there via Config -> Connection -> Regenerate.
DATABASE_URL=postgres://user:password@host:5432/dbname

BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=10

# Public base URL used to build links in outgoing email (portal invites etc).
# Falls back to the request host if unset.
PUBLIC_BASE_URL=https://pt-worktime.srscloud.co.uk

# --- Superuser seed (bootstrap only) ----------------------------------------
# On boot the app creates this superuser if absent, and updates its password to
# match SU_PASSWORD if it has changed. SU_PASSWORD is a real admin password -
# treat it as a secret and rotate it here, then redeploy.
SU_USERNAME=srs-support
SU_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SU_FULL_NAME=SRS Support

# --- Cloudflare R2 (profile avatars) ----------------------------------------
# S3-compatible object storage. R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY are
# secrets - rotate them in the Cloudflare R2 dashboard. The feature disables
# itself gracefully if these are unset.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_BUCKET=worktime-avatars
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# --- Email (Resend, transactional) ------------------------------------------
# RESEND_API_KEY is a secret - rotate it in the Resend dashboard. Email
# disables itself gracefully (logs instead of sends) if the key is unset.
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
EMAIL_FROM=Philtronics Work Time <noreply@yourdomain>
EMAIL_REPLY_TO=someone@yourdomain
# Internal address that receives portal notifications (new RFQ, customer reply).
EMAIL_INTERNAL_TO=someone@yourdomain
